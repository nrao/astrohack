            "nullable": false,
            "required": true,
            "type": ["string"]
        },
        "ant":{
            "nullable": false,
            "required": false,
            "struct_type": [
                "str"
            ],
            "minlength": 1,
            "type": [
                "string",
                "list"
            ]
        },
        "pointing_key":{
            "allowed": ["DIRECTION", "DIRECTIONAL_COSINES", "ENCODER", "POINTING_OFFSET", "TARGET"],
