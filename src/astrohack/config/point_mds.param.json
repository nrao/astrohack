            "required": false,
            "type": ["boolean"]
        },
        "azel_unit":{
            "nullable": false,
            "required": false,
            "type": [
                "string"
            ],
            "check allowed with": "units.trig"
        },
        "time_unit":{
            "nullable": false,
            "required": false,
            "type": [
                "string"
            ],
            "check allowed with": "units.time"
        },
        "az_scale":{
            "nullable": true,
            "required": false,
