            "maxlength": 2,
            "type": ["tuple", "list", "ndarray"]
        },
        "el_scale":{
            "nullable": true,
            "required": false,
            "struct_type": ["float", "int"],
            "minlength": 2,
            "maxlength": 2,
            "type": ["tuple", "list", "ndarray"]
        },
        "time_scale":{
            "nullable": true,
            "required": false,
            "struct_type": ["float", "int"],
            "minlength": 2,
            "maxlength": 2,
            "type": ["tuple", "list", "ndarray"]
        },
        "display":{
            "nullable": false,
            "required": false,
            "type": ["boolean"]
        },
        "figure_size":{
            "nullable": true,
            "required": false,
            "struct_type": ["float", "int"],
            "minlength": 2,
            "maxlength": 2,
            "type": ["list", "tuple", "ndarray"]
        },
        "dpi": {
            "nullable": false,
            "required": false,
            "type": ["int"],
            "min": 1,
            "max": 1200
        }
    },
    "AstrohackPointFile.plot_array_configuration":{
